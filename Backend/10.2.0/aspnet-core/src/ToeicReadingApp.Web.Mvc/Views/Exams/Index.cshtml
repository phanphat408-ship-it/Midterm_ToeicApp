@using ToeicReadingApp.Web.Startup
@using ToeicReadingApp.Exams.Dto
@model List<ExamListDto>
@{
    ViewBag.Title = "Quản lý Đề thi TOEIC Reading";
    ViewBag.CurrentPageName = PageNames.Exams;
    var errors = TempData["Errors"] as List<string>;
    var successMsg = TempData["Success"] as string;
    var totalQuestions = Model?.Sum(x => x.TotalQuestions) ?? 0;
}

<style>
    .page-hero {
        background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);
        color: #ffffff;
        border-radius: 12px;
        padding: 24px 28px;
        margin-bottom: 24px;
        box-shadow: 0 8px 24px rgba(30, 60, 114, 0.15);
    }
    .stat-card {
        background: #ffffff;
        border-radius: 12px;
        padding: 18px 22px;
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        display: flex;
        align-items: center;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }
    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-right: 16px;
    }
    .modern-card {
        border-radius: 12px;
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 4px 16px rgba(0,0,0,0.04);
        overflow: hidden;
        background: #ffffff;
        margin-bottom: 24px;
    }
    .modern-card-header {
        background: #ffffff;
        border-bottom: 1px solid rgba(0,0,0,0.06);
        padding: 18px 24px;
    }
    .upload-zone {
        border: 2px dashed #3b82f6;
        border-radius: 10px;
        padding: 24px;
        background: #f8fafc;
        text-align: center;
        transition: all 0.2s ease;
    }
    .upload-zone:hover {
        background: #f1f5f9;
        border-color: #2563eb;
    }
    .table-modern thead th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 2px solid #e2e8f0;
        padding: 14px 16px;
    }
    .table-modern tbody td {
        padding: 16px;
        vertical-align: middle;
        border-top: 1px solid #f1f5f9;
        font-size: 0.95rem;
    }
    .table-modern tbody tr:hover {
        background-color: #f8fafc;
    }
    .tag-badge {
        font-family: monospace;
        background: #e2e8f0;
        color: #334155;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 0.82rem;
    }
</style>

<div class="content-header p-0 mb-3">
    <div class="container-fluid">
        <!-- Page Hero Banner -->
        <div class="page-hero d-flex flex-column flex-md-row justify-content-between align-items-md-center">
            <div>
                <h2 class="font-weight-bold mb-1 d-flex align-items-center">
                    <i class="fas fa-graduation-cap mr-3" style="font-size: 2rem;"></i>
                    Quản lý Đề thi TOEIC Reading
                </h2>
                <p class="mb-0 text-white-50" style="font-size: 1rem;">
                    Hệ thống trích xuất thông minh từ Word (.docx), kiểm duyệt toàn vẹn All-or-Nothing và cấu trúc 3 phần TOEIC
                </p>
            </div>
            <div class="mt-3 mt-md-0 d-flex flex-wrap gap-2">
                <a href="@Url.Action("DownloadSample", "Exams")" class="btn btn-light font-weight-bold shadow-sm mr-2 mb-2">
                    <i class="fas fa-file-word text-primary mr-1"></i> Tải file Word mẫu (.docx)
                </a>
                <a href="@Url.Action("DownloadErrorSample", "Exams")" class="btn btn-outline-light font-weight-bold mb-2">
                    <i class="fas fa-bug text-warning mr-1"></i> File Word test lỗi
                </a>
            </div>
        </div>

        <!-- Quick Stats Overview -->
        <div class="row mb-4">
            <div class="col-md-4 col-sm-6 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-primary text-white">
                        <i class="fas fa-layer-group"></i>
                    </div>
                    <div>
                        <div class="text-muted small font-weight-bold text-uppercase">Tổng số Đề thi</div>
                        <div class="h3 font-weight-bold text-dark mb-0">@(Model?.Count ?? 0)</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-6 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-success text-white">
                        <i class="fas fa-question"></i>
                    </div>
                    <div>
                        <div class="text-muted small font-weight-bold text-uppercase">Tổng số Câu hỏi trong DB</div>
                        <div class="h3 font-weight-bold text-dark mb-0">@totalQuestions</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-12 mb-3">
                <div class="stat-card">
                    <div class="stat-icon bg-info text-white">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <div>
                        <div class="text-muted small font-weight-bold text-uppercase">Cơ chế Kiểm duyệt</div>
                        <div class="h6 font-weight-bold text-info mb-0">100% In-Memory All-or-Nothing</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        @* Alert Error Box *@
        @if (errors != null && errors.Any())
        {
            <div class="alert alert-danger shadow-sm border-left-danger fade show mb-4 p-4" style="border-radius: 10px; border-left: 6px solid #dc3545;" role="alert">
                <div class="d-flex align-items-start mb-2">
                    <i class="fas fa-exclamation-triangle fa-2x mr-3 text-danger mt-1"></i>
                    <div>
                        <h5 class="alert-heading font-weight-bold mb-1">
                            PHÁT HIỆN LỖI ĐỊNH DẠNG FILE WORD - QUY TRÌNH ALL-OR-NOTHING KÍCH HOẠT!
                        </h5>
                        <p class="mb-0 text-muted">
                            Toàn bộ thao tác nạp đề đã bị <strong>hủy bỏ an toàn</strong>. <strong>Không có bản ghi nào bị ghi đè hay rác DB</strong>. Vui lòng kiểm tra và sửa các lỗi bên dưới:
                        </p>
                    </div>
                </div>
                <hr class="my-3" />
                <ul class="mb-0 pl-4 font-weight-bold text-danger">
                    @foreach (var err in errors)
                    {
                        <li class="py-1">@err</li>
                    }
                </ul>
            </div>
        }

        @* Alert Success Box *@
        @if (!string.IsNullOrEmpty(successMsg))
        {
            <div class="alert alert-success shadow-sm alert-dismissible fade show mb-4 p-4" style="border-radius: 10px; border-left: 6px solid #28a745;" role="alert">
                <div class="d-flex align-items-center">
                    <i class="fas fa-check-circle fa-2x mr-3 text-success"></i>
                    <div>
                        <h5 class="alert-heading font-weight-bold mb-0">Thao tác thành công!</h5>
                        <span>@successMsg</span>
                    </div>
                </div>
                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
        }

        <!-- Upload & Seed Section -->
        <div class="row">
            <div class="col-lg-8">
                <div class="modern-card">
                    <div class="modern-card-header d-flex justify-content-between align-items-center">
                        <h5 class="font-weight-bold text-dark mb-0">
                            <i class="fas fa-cloud-upload-alt text-primary mr-2"></i>Tải lên & Phân tích Đề thi từ Word (.docx)
                        </h5>
                        <span class="badge badge-light border px-2 py-1 text-muted"><i class="fas fa-file-code mr-1"></i>OpenXml Parser</span>
                    </div>
                    <div class="p-4">
                        <form asp-action="Upload" asp-controller="Exams" method="post" enctype="multipart/form-data" id="uploadForm">
                            @Html.AntiForgeryToken()
                            <div class="upload-zone mb-3">
                                <i class="fas fa-file-word fa-3x text-primary mb-2"></i>
                                <h6 class="font-weight-bold text-dark mb-1">Kéo thả file .docx vào đây hoặc bấm chọn</h6>
                                <p class="text-muted small mb-3">Chấp nhận định dạng chuẩn Microsoft Word (.docx)</p>
                                
                                <div class="custom-file mx-auto" style="max-width: 480px;">
                                    <input type="file" class="custom-file-input" id="wordFileInput" name="file" accept=".docx" required />
                                    <label class="custom-file-label text-left font-weight-normal" for="wordFileInput">Chọn file đề thi .docx...</label>
                                </div>
                            </div>
                            
                            <div class="bg-light p-3 rounded mb-3 border">
                                <div class="small font-weight-bold text-secondary mb-1">
                                    <i class="fas fa-tags text-primary mr-1"></i> Các thẻ định dạng hệ thống tự động bóc tách:
                                </div>
                                <div class="small text-muted">
                                    <span class="tag-badge mr-1">[EXAM_TITLE]</span>
                                    <span class="tag-badge mr-1">[DURATION]</span>
                                    <span class="tag-badge mr-1">[PART:5|6|7]</span>
                                    <span class="tag-badge mr-1">[GROUP_START]</span>
                                    <span class="tag-badge mr-1">[PASSAGE_START]</span>
                                    <span class="tag-badge mr-1">[Q:101]</span>
                                    <span class="tag-badge mr-1">[A]...[D]</span>
                                    <span class="tag-badge">[ANS:A|B|C|D]</span>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <button type="submit" class="btn btn-primary px-4 py-2 font-weight-bold shadow-sm" id="btnSubmitUpload">
                                    <i class="fas fa-upload mr-1"></i> Tải lên & Phân tích Đề thi
                                </button>
                                <span class="badge badge-success px-3 py-2 font-weight-bold">
                                    <i class="fas fa-shield-alt mr-1"></i> Strict In-Memory Validation
                                </span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="modern-card">
                    <div class="modern-card-header">
                        <h5 class="font-weight-bold text-info mb-0">
                            <i class="fas fa-bolt mr-2"></i>Nạp Đề Test 05 Chuẩn
                        </h5>
                    </div>
                    <div class="p-4">
                        <p class="text-muted small mb-3">
                            Khởi tạo nhanh <strong>Đề thi TOEIC Reading Practice Test 05 chuẩn 100 câu</strong> (Part 5: 30 câu, Part 6: 16 câu, Part 7: 54 câu kèm bài đọc):
                        </p>
                        <form asp-action="CreateSampleTest" asp-controller="Exams" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-info btn-block text-white font-weight-bold shadow-sm py-2 mb-3">
                                <i class="fas fa-magic mr-1"></i> Nạp nhanh Test 05 vào DB
                            </button>
                        </form>
                        <div class="small text-muted border-top pt-2">
                            <i class="fas fa-check-circle text-success mr-1"></i> Đã test tương thích hoàn toàn với Flutter Mobile Client.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Table of Exams -->
        <div class="modern-card">
            <div class="modern-card-header d-flex justify-content-between align-items-center">
                <h5 class="font-weight-bold text-dark mb-0">
                    <i class="fas fa-list text-primary mr-2"></i>Danh sách Đề thi trong Hệ thống
                </h5>
                <span class="badge badge-primary px-3 py-2 font-weight-bold">Tổng cộng: @(Model?.Count ?? 0) đề</span>
            </div>
            <div class="table-responsive">
                <table class="table table-modern mb-0">
                    <thead>
                        <tr>
                            <th style="width: 70px;" class="text-center">ID</th>
                            <th>Tên đề thi</th>
                            <th style="width: 140px;" class="text-center">Thời gian</th>
                            <th style="width: 130px;" class="text-center">Số câu hỏi</th>
                            <th style="width: 120px;" class="text-center">Số Part</th>
                            <th style="width: 160px;">Ngày tạo</th>
                            <th style="width: 200px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center font-weight-bold text-muted">#@item.Id</td>
                                    <td>
                                        <div class="font-weight-bold text-primary" style="font-size: 1.05rem;">
                                            @item.Title
                                        </div>
                                        <small class="text-muted">@item.Description</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-warning px-3 py-2 font-weight-bold text-dark" style="border-radius: 8px;">
                                            <i class="far fa-clock mr-1"></i>@item.DurationMinutes phút
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-info px-3 py-2 font-weight-bold" style="border-radius: 8px;">
                                            @item.TotalQuestions câu
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-secondary px-3 py-2 font-weight-bold" style="border-radius: 8px;">
                                            @item.PartCount phần
                                        </span>
                                    </td>
                                    <td>
                                        <span class="text-muted small font-weight-bold">@item.CreationTime.ToString("dd/MM/yyyy HH:mm")</span>
                                    </td>
                                    <td class="text-center">
                                        <a href="@Url.Action("Preview", "Exams", new { id = item.Id })" class="btn btn-sm btn-primary shadow-sm mr-1 font-weight-bold" title="Xem trước & Chỉnh sửa chi tiết">
                                            <i class="fas fa-eye mr-1"></i> Xem & Sửa
                                        </a>
                                        <form asp-action="Delete" asp-controller="Exams" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa đề thi này không? Toàn bộ các câu hỏi và bài làm liên quan sẽ bị xóa vĩnh viễn.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger shadow-sm" title="Xóa đề thi">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-folder-open fa-3x mb-3 text-secondary d-block"></i>
                                    Chưa có đề thi nào trong hệ thống. Hãy tải lên file Word (.docx) hoặc bấm "Nạp nhanh Test 05 vào DB".
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script>
        $(function () {
            $('#wordFileInput').on('change', function () {
                var fileName = $(this).val().split('\\').pop();
                $(this).next('.custom-file-label').addClass("selected").html(fileName || 'Chọn file đề thi .docx...');
            });

            $('#uploadForm').on('submit', function () {
                $('#btnSubmitUpload').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang phân tích & kiểm duyệt...');
            });
        });
    </script>
}
