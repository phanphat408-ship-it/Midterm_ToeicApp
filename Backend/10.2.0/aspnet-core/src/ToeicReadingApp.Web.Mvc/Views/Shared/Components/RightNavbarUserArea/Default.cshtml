@model ToeicReadingApp.Web.Views.Shared.Components.RightNavbarUserArea.RightNavbarUserAreaViewModel
<li class="nav-item dropdown nav-user-menu">
    <a href="javascript:void(0);" class="nav-link" data-toggle="dropdown" data-bs-toggle="dropdown" role="button">
        <img class="user-image img-circle elevation-2" src="~/img/avatar.png" alt="User Image" style="width: 32px !important; height: 32px !important; max-width: 32px !important; max-height: 32px !important; object-fit: cover !important; border-radius: 50% !important;">
    </a>
    <div class="dropdown-menu dropdown-menu-right">
        <a class="dropdown-item" asp-controller="Users" asp-action="ChangePassword">
            <i class="fas fa-user-edit"></i> @L("UpdatePassword")
        </a>
        <a class="dropdown-item" asp-controller="Account" asp-action="Logout">
            <i class="fas fa-sign-out-alt"></i> @L("Logout")
        </a>
    </div>
</li>

