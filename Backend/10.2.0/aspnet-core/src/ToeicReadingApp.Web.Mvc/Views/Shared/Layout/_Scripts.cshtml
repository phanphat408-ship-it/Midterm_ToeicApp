@using System.Globalization
@using Abp.AspNetCore.Mvc.Caching
@using Abp.CachedUniqueKeys
@inject ToeicReadingApp.Timing.AppTimes AppTimes
@inject ICachedUniqueKeyPerUser CachedUniqueKeyPerUser
@inject IGetScriptsResponsePerUserConfiguration GetScriptsResponsePerUserConfiguration

<!-- Core Client Libraries from CDNs (Guarantees 100% UI Functionality) -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.30.1/moment.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

<!-- Optional bundled scripts (fallback to CDN if absent) -->
<script src="~/view-resources/Views/_Bundles/shared-layout.min.js" asp-append-version="true" onerror="console.warn('Local bundle missing, using CDN libraries.');"></script>

<script type="text/javascript">
    // This is used to get the application's root path from javascript.
    var abp = abp || {};
    abp.appPath = '@ApplicationPath';
    abp.localization = abp.localization || { localize: function(key, source) { return key; } };
    abp.notify = abp.notify || {
        success: function(msg) { if (window.toastr) toastr.success(msg); else alert(msg); },
        info: function(msg) { if (window.toastr) toastr.info(msg); else alert(msg); },
        warn: function(msg) { if (window.toastr) toastr.warning(msg); else alert(msg); },
        error: function(msg) { if (window.toastr) toastr.error(msg); else alert(msg); }
    };
    abp.message = abp.message || {
        confirm: function(msg, title, callback) {
            if (typeof title === 'function') { callback = title; title = 'Xác nhận'; }
            if (window.swal) {
                swal({ title: title || 'Xác nhận', text: msg, icon: 'warning', buttons: ['Hủy', 'Đồng ý'], dangerMode: true }).then(function(isConfirm) { if (isConfirm && callback) callback(); });
            } else {
                if (confirm(msg) && callback) callback();
            }
        },
        info: function(msg, title) { if (window.swal) swal(title || 'Thông báo', msg, 'info'); else alert(msg); },
        success: function(msg, title) { if (window.swal) swal(title || 'Thành công', msg, 'success'); else alert(msg); },
        warn: function(msg, title) { if (window.swal) swal(title || 'Cảnh báo', msg, 'warning'); else alert(msg); },
        error: function(msg, title) { if (window.swal) swal(title || 'Lỗi', msg, 'error'); else alert(msg); }
    };
    abp.ui = abp.ui || {
        setBusy: function() {},
        clearBusy: function() {},
        block: function() {},
        unblock: function() {}
    };
</script>

@if (CultureInfo.CurrentUICulture.Name != "en")
{
    var normalizedCurrentUICultureName = CultureInfo.CurrentUICulture.Name.Replace("-", "_");
    var localizationFileNameWithExtension = "messages_";
    switch (normalizedCurrentUICultureName)
    {
        case "zh_Hans":
            localizationFileNameWithExtension += "zh";
            break;
        case "es_MX":
            localizationFileNameWithExtension += "es";
            break;
        default:
            localizationFileNameWithExtension += normalizedCurrentUICultureName;
            break;
    }
    localizationFileNameWithExtension += ".min.js";
    <script src="~/libs/jquery-validate/localization/@localizationFileNameWithExtension" asp-append-version="true"></script>
}

<script type="text/javascript">
        // Localizing momentjs
        moment.locale('@CultureInfo.CurrentUICulture.Name');
</script>

<!-- Dynamic scripts of ABP system (They are created on runtime and can not be bundled) -->
<script src="~/AbpServiceProxies/GetAll?v=@(AppTimes.StartupTime.Ticks)" type="text/javascript"></script>

@if (GetScriptsResponsePerUserConfiguration.IsEnabled)
{
    <script src="@(ApplicationPath)AbpScripts/GetScripts?v=@(await CachedUniqueKeyPerUser.GetKeyAsync(GetScriptsResponsePerUserCache.CacheName))" type="text/javascript"></script>
}
else
{
    <script src="@(ApplicationPath)AbpScripts/GetScripts?v=@(AppTimes.StartupTime.Ticks)" type="text/javascript"></script>
}